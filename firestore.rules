rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasProfile()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow create: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == 'customer'
          && request.resource.data.keys().hasOnly(['fullName', 'email', 'role', 'createdAt']));
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // Business data is accessed through the Express API, which verifies Firebase ID tokens
    // and applies validation, role checks, and Firestore transactions server-side.
    match /{collection}/{document} {
      allow read, write: if false;
    }
  }
}